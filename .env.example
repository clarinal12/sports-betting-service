NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://sports:sports@localhost:5432/sports_betting
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

# --- Auth (Phase 3a) ---
# Dev defaults are applied automatically; override (and set strong values) in production.
SESSION_JWT_SECRET=dev-session-secret-change-me-please
SESSION_TTL=30m
SECRET_ENCRYPTION_KEY=dev-encryption-key-change-me-please
# Allow the dev-only X-Casino-Group header to resolve a tenant without a launch token.
AUTH_ALLOW_HEADER_FALLBACK=true
OPERATOR_JWT_CLOCK_SKEW=5
# USER_SERVICE_BASE_URL=https://users.example.com   # used from Phase 4

# --- Real-time (Phase 3b) ---
REALTIME_SUBSCRIBE_MAX_PER_MINUTE=60

# --- CORS (development only) ---
# Ignored when NODE_ENV=production. Used by local browser clients (Next.js shell).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Fixture provider (Phase 3c — The Odds API) ---
# mock = deterministic local data (tests, CI). odds-api = live data.
FIXTURE_PROVIDER=odds-api
ODDS_API_KEY=your-odds-api-key-here
# ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# Shared catalog ingest (group aliases). Tenant offerings filter acme vs betzone in-app.
ODDS_API_SPORT_KEYS=basketball,baseball,americanfootball,soccer
# all = us,us2,uk,eu,au
ODDS_API_REGIONS=all
ODDS_API_MARKETS=h2h,spreads,totals
ODDS_API_ODDS_FORMAT=decimal

# In-process ingest schedulers (CLI ingest:fixtures / ingest:live still work when disabled).
# Recommended for odds-api production: live every 60s, catalog every 6 hours.
INGEST_LIVE_ENABLED=false
INGEST_LIVE_INTERVAL_SECONDS=60
INGEST_CATALOG_ENABLED=false
INGEST_CATALOG_CRON=0 */6 * * *
INGEST_LIVE_PRESTART_MINUTES=15
# Pause scheduled ingest when quota is low or API returns 401.
# INGEST_ODDS_API_REMAINING_MIN=20
# INGEST_ODDS_API_PAUSE_MINUTES=30
