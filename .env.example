NODE_ENV=development
PORT=5003

DATABASE_URL=postgresql://sports:sports@localhost:5432/sports_betting
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

# --- Observability (Phase 5) ---
METRICS_ENABLED=true

# --- Back office staff auth (Phase 6) ---
STAFF_JWT_SECRET=dev-staff-jwt-secret-change-me-please
STAFF_ACCESS_TTL=15m
STAFF_REFRESH_TTL=7d

# --- Auth (Phase 3a) ---
# Dev defaults are applied automatically; override (and set strong values) in production.
SESSION_JWT_SECRET=dev-session-secret-change-me-please
SESSION_TTL=30m
SECRET_ENCRYPTION_KEY=dev-encryption-key-change-me-please
# Allow the dev-only X-Casino-Group header to resolve a tenant without a launch token.
AUTH_ALLOW_HEADER_FALLBACK=true
OPERATOR_JWT_CLOCK_SKEW=5
# --- Wallet / betting (Phase 4) ---
# stub = in-memory balance (local dev). http = external user service.
WALLET_PROVIDER=stub
WALLET_STUB_BALANCE=10000.00
# USER_SERVICE_BASE_URL=https://users.example.com
# WALLET_PROVIDER=http
# BET_MIN_STAKE=1.00
# BET_MAX_STAKE=10000.00
# BET_MAX_PAYOUT=100000.00
# WALLET_OUTBOX_POLL_SECONDS=30

# --- Settlement / results (recommended for odds-api dev) ---
# Bet-driven /scores for ACCEPTED bets, then settle. Use ingest:results CLI too.
RESULTS_INGEST_ENABLED=false
RESULTS_INGEST_POLL_SECONDS=120
SETTLEMENT_STALE_HOURS=6
ODDS_API_SCORES_DAYS_FROM=3
# Leave off when RESULTS_INGEST_ENABLED=true (settle is included in results tick).
SETTLEMENT_ENABLED=false
# SETTLEMENT_POLL_SECONDS=60

# --- Real-time (Phase 3b) ---
REALTIME_SUBSCRIBE_MAX_PER_MINUTE=60

# --- CORS (development only) ---
# Ignored when NODE_ENV=production. Used by local browser clients (Next.js shell).
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001,http://localhost:5002,http://127.0.0.1:5002

# --- Fixture provider (Phase 3c — The Odds API) ---
# mock = deterministic local data (tests, CI). odds-api = live data.
# odds-api catalog ingest upserts only; mock ingest may purge stale mock_* fixtures.
FIXTURE_PROVIDER=odds-api
ODDS_API_KEY=your-odds-api-key-here
# ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# Shared catalog ingest. Demo tenants (acme, betzone) offer NBA only in-app.
ODDS_API_SPORT_KEYS=basketball_nba
# all = us,us2,uk,eu,au
ODDS_API_REGIONS=all
ODDS_API_MARKETS=h2h,spreads,totals
ODDS_API_ODDS_FORMAT=decimal

# In-process ingest schedulers (CLI commands still work when disabled).
# Recommended: results on (above); catalog every 6h; live only when using in-play UI.
INGEST_LIVE_ENABLED=false
INGEST_LIVE_INTERVAL_SECONDS=60
INGEST_CATALOG_ENABLED=false
INGEST_CATALOG_CRON=0 */6 * * *
INGEST_LIVE_PRESTART_MINUTES=15
# Pause scheduled ingest when quota is low or API returns 401.
# INGEST_ODDS_API_REMAINING_MIN=20
# INGEST_ODDS_API_PAUSE_MINUTES=30
