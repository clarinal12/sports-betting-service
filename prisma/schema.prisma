generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CasinoGroupStatus {
  ACTIVE
  DISABLED
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  ENDED
  POSTPONED
  CANCELLED
}

enum EventStatus {
  SCHEDULED
  LIVE
  SUSPENDED
  ENDED
  CANCELLED
}

enum MarketType {
  MATCH_RESULT
  HANDICAP
  TOTAL
  DOUBLE_CHANCE
  BOTH_TEAMS_SCORE
}

enum MarketStatus {
  OPEN
  SUSPENDED
  SETTLED
  VOID
}

enum SelectionStatus {
  OPEN
  SUSPENDED
  SETTLED
  VOID
}

enum BetStatus {
  PENDING
  ACCEPTED
  REJECTED
  WON
  LOST
  VOID
}

enum BetLegOutcome {
  PENDING
  WON
  LOST
  VOID
}

enum WalletOutboxStatus {
  PENDING
  COMPLETED
  FAILED
}

enum StaffUserStatus {
  ACTIVE
  DISABLED
}

enum StaffRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  OPERATOR_ADMIN
  TRADER
  RISK_MANAGER
  CUSTOMER_SUPPORT
  SETTLEMENT
  FINANCE
  COMPLIANCE
}

/// A tenant (white-label operator). Players and content are scoped to a group.
model CasinoGroup {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  defaultCurrency String            @default("USD")
  timezone        String            @default("UTC")
  status          CasinoGroupStatus @default(ACTIVE)
  /// Operator id carried in the launch JWT (`merchantId` claim).
  merchantId      String?           @unique
  /// Per-merchant HMAC secret for verifying launch tokens, encrypted at rest.
  /// Never returned by any API.
  sportsSecret    String?
  /// Client wallet API base URL (balance, transaction, batch-transactions).
  walletApiUrl    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  leagues         CasinoGroupLeague[]
  staffUsers      StaffUser[]
  staffAccess     StaffCasinoGroupAccess[]
  offeringPolicy  OfferingPolicy?
  riskLimits      RiskLimit[]

  @@map("casino_groups")
}

/// Global sport catalog (shared across tenants; enablement is per-tenant).
model Sport {
  id     String  @id @default(cuid())
  key    String  @unique
  name   String
  slug   String  @unique
  active Boolean @default(true)

  leagues League[]
  teams   Team[]

  @@map("sports")
}

/// Global league/competition catalog, scoped to a sport.
model League {
  id      String  @id @default(cuid())
  sportId String
  key     String  @unique
  name    String
  region  String?
  active  Boolean @default(true)

  sport     Sport               @relation(fields: [sportId], references: [id], onDelete: Cascade)
  fixtures  Fixture[]
  groups    CasinoGroupLeague[]

  @@index([sportId])
  @@map("leagues")
}

/// Participant in a sport (team or competitor).
model Team {
  id        String  @id @default(cuid())
  sportId   String
  key       String  @unique
  name      String
  shortName String?

  sport         Sport     @relation(fields: [sportId], references: [id], onDelete: Cascade)
  homeFixtures  Fixture[] @relation("HomeTeam")
  awayFixtures  Fixture[] @relation("AwayTeam")

  @@index([sportId])
  @@map("teams")
}

/// A scheduled match between two teams in a league.
model Fixture {
  id          String        @id @default(cuid())
  leagueId    String
  homeTeamId  String
  awayTeamId  String
  startsAt    DateTime
  status      FixtureStatus @default(SCHEDULED)
  providerRef String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])
  event    Event?

  @@index([leagueId, startsAt])
  @@index([status, startsAt])
  @@map("fixtures")
}

/// Join table: which leagues a casino group offers to its players.
model CasinoGroupLeague {
  casinoGroupId  String
  leagueId       String
  enabled        Boolean @default(true)
  /// Set when platform staff disable; tenant operators cannot re-enable until platform clears it.
  platformLocked Boolean @default(false)

  casinoGroup CasinoGroup @relation(fields: [casinoGroupId], references: [id], onDelete: Cascade)
  league      League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@id([casinoGroupId, leagueId])
  @@index([leagueId])
  @@map("casino_group_leagues")
}

/// Live wrapper around a fixture: status, score, and clock while in play.
/// 1:1 with Fixture; created/updated by ingestion.
model Event {
  id          String      @id @default(cuid())
  fixtureId   String      @unique
  providerRef String      @unique
  status      EventStatus @default(SCHEDULED)
  homeScore   Int?
  awayScore   Int?
  period      String?
  clock       String?
  startedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  fixture Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  markets Market[]

  @@index([status])
  @@map("events")
}

/// A bet type on an event (e.g. 1X2, Over/Under 2.5). `line` holds the
/// handicap/total value when the market type uses one.
model Market {
  id          String       @id @default(cuid())
  eventId     String
  providerRef String       @unique
  type        MarketType
  status      MarketStatus @default(OPEN)
  line        Decimal?     @db.Decimal(6, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selections Selection[]

  @@index([eventId, type])
  @@map("markets")
}

/// One outcome within a market, carrying the current decimal price.
model Selection {
  id          String          @id @default(cuid())
  marketId    String
  providerRef String          @unique
  name        String
  status      SelectionStatus @default(OPEN)
  price       Decimal         @db.Decimal(10, 3)
  updatedAt   DateTime        @updatedAt

  market   Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  snapshots OddsSnapshot[]
  betLegs   BetLeg[]

  @@index([marketId])
  @@map("selections")
}

/// Player bet (single or accumulator). Wallet debit is driven by `wallet_outbox`.
model Bet {
  id                  String    @id @default(cuid())
  casinoGroupId       String
  userId              String
  /// Operator username — sent to merchant wallet as `userCode`.
  username            String    @default("")
  idempotencyKey      String
  stake               Decimal   @db.Decimal(12, 2)
  currency            String
  status              BetStatus @default(PENDING)
  combinedOdds        Decimal   @db.Decimal(12, 3)
  potentialPayout     Decimal   @db.Decimal(14, 2)
  walletReservationId String?
  rejectionReason     String?
  /// Actual payout credited on WON; stake returned on VOID; 0 on LOST.
  payoutAmount        Decimal?  @db.Decimal(14, 2)
  settledAt           DateTime?
  /// Set when results are overdue from the provider (cleared on settle or manual result).
  settlementNote      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  legs         BetLeg[]
  walletOutbox WalletOutbox[]

  @@unique([casinoGroupId, userId, idempotencyKey])
  @@index([casinoGroupId, userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("bets")
}

/// One selection leg within a bet (price frozen at placement).
model BetLeg {
  id                 String  @id @default(cuid())
  betId              String
  selectionId        String
  marketId           String
  eventId            String
  selectionName      String
  priceAtPlacement   Decimal       @db.Decimal(10, 3)
  legOrder           Int
  outcome            BetLegOutcome @default(PENDING)
  /// Frozen at placement — used for settlement grading (FR-B snapshot).
  marketType         MarketType?
  marketLine         Decimal?      @db.Decimal(6, 2)
  homeTeamName       String?
  awayTeamName       String?
  eventProviderRef   String?
  sportKey           String?
  sportName          String?
  leagueKey          String?
  leagueName         String?

  bet       Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  selection Selection @relation(fields: [selectionId], references: [id])

  @@index([betId])
  @@index([selectionId])
  @@map("bet_legs")
}

/// Async delivery of wallet API calls (debit, settlement batch, staff void).
model WalletOutbox {
  id              String             @id @default(cuid())
  betId           String
  casinoGroupId   String
  type            String
  transactionCode String             @unique
  /// Shared across settlement outbox rows retried in the same batch HTTP call.
  batchId         String?
  payload         Json
  status          WalletOutboxStatus @default(PENDING)
  attempts        Int                @default(0)
  lastError       String?
  nextRetryAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  bet Bet @relation(fields: [betId], references: [id], onDelete: Cascade)

  @@unique([betId, type])
  @@index([status, type, casinoGroupId, nextRetryAt])
  @@map("wallet_outbox")
}

/// Append-only price history for audit and charts. Plain Postgres for now;
/// convert to a TimescaleDB hypertable in a later phase.
model OddsSnapshot {
  id          String   @id @default(cuid())
  selectionId String
  price       Decimal  @db.Decimal(10, 3)
  capturedAt  DateTime @default(now())

  selection Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@index([selectionId, capturedAt])
  @@map("odds_snapshots")
}

/// Append-only audit trail for tenant/offering changes (Phase 5 — back office prep).
model AuditLogEntry {
  id            String   @id @default(cuid())
  actorType     String
  actorId       String?
  casinoGroupId String?
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([casinoGroupId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_log_entries")
}

/// Back-office operator (Phase 6). Not a player.
model StaffUser {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  /// Null = platform operator (cross-tenant); otherwise scoped to one casino group.
  casinoGroupId String?
  roles         StaffRole[]
  status        StaffUserStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  casinoGroup   CasinoGroup?             @relation(fields: [casinoGroupId], references: [id], onDelete: SetNull)
  sessions      StaffSession[]
  tenantAccess  StaffCasinoGroupAccess[]

  @@index([casinoGroupId])
  @@map("staff_users")
}

/// SUPER_ADMIN grants: which casino groups a PLATFORM_ADMIN may access.
model StaffCasinoGroupAccess {
  staffUserId   String
  casinoGroupId String
  createdAt     DateTime @default(now())

  staffUser   StaffUser   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  casinoGroup CasinoGroup @relation(fields: [casinoGroupId], references: [id], onDelete: Cascade)

  @@id([staffUserId, casinoGroupId])
  @@map("staff_casino_group_access")
}

/// Refresh-token session for staff (separate from player session JWT).
model StaffSession {
  id               String    @id @default(cuid())
  staffUserId      String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("staff_sessions")
}

/// Per-tenant product rules (market types per sport, etc.) — Phase 6 product domain.
model OfferingPolicy {
  id            String   @id @default(cuid())
  casinoGroupId String   @unique
  rules         Json?
  updatedAt     DateTime @updatedAt

  casinoGroup CasinoGroup @relation(fields: [casinoGroupId], references: [id], onDelete: Cascade)

  @@map("offering_policies")
}

/// Stake/payout caps per tenant (GLOBAL scope in MVP).
model RiskLimit {
  id            String   @id @default(cuid())
  casinoGroupId String
  scope         String
  scopeRef      String?
  minStake      Decimal? @db.Decimal(12, 2)
  maxStake      Decimal? @db.Decimal(12, 2)
  maxPayout     Decimal? @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  casinoGroup CasinoGroup @relation(fields: [casinoGroupId], references: [id], onDelete: Cascade)

  @@unique([casinoGroupId, scope, scopeRef])
  @@map("risk_limits")
}
